rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && (
        getUserData().role == 'staff' ||
        isAdmin()
      );
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Users can create/update their own document (e.g. register, save FCM tokens), Admin can do everything
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 2. Barbershops collection
    match /barbershops/{barbershopId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 3. Barbers collection
    match /barbers/{barberId} {
      allow read: if isAuthenticated();
      // Admin and staff can create and update barbers and balance
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 4. Sales collection
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();

      // Admins can edit any transaction.
      // Staff can edit only their own transaction for 12 hours after creation.
      // Staff cannot transfer ownership or rewrite the creation timestamp.
      allow update: if isAdmin() || (
        isStaff() &&
        resource.data.staffId == request.auth.uid &&
        request.resource.data.staffId == resource.data.staffId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.time < resource.data.createdAt + duration.value(12, 'h')
      );

      // Only Admin can delete sales records
      allow delete: if isAdmin();
    }

    // 5. Daily Reports collection
    match /dailyReports/{reportId} {
      allow read: if isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
